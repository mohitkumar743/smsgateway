@baseUrl = http://localhost:3000
@adminJwt = REPLACE_ADMIN_JWT
@deviceToken = REPLACE_DEVICE_TOKEN
@clientApiKey = REPLACE_CLIENT_API_KEY
@requestId = REPLACE_REQUEST_ID

### Admin login
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "admin@example.com",
  "password": "replace-with-a-strong-password"
}

### Register Android device
POST {{baseUrl}}/api/device/register
Content-Type: application/json

{
  "device_name": "Google Pixel 8",
  "android_version": "Android 14 (API 34)",
  "app_version": "1.0_gateway",
  "fcm_token": "REPLACE_WITH_REAL_FIREBASE_TOKEN_AT_LEAST_20_CHARS"
}

### Device heartbeat
POST {{baseUrl}}/api/device/heartbeat
Authorization: Bearer {{deviceToken}}
Content-Type: application/json

{
  "battery_optimization_ignored": true,
  "sms_permission": true,
  "sim_ready": true,
  "foreground_service_running": true
}

### Update device FCM token
POST {{baseUrl}}/api/device/update-fcm-token
Authorization: Bearer {{deviceToken}}
Content-Type: application/json

{
  "fcm_token": "REPLACE_WITH_NEW_FIREBASE_TOKEN_AT_LEAST_20_CHARS"
}

### Create client
POST {{baseUrl}}/api/clients/create
Authorization: Bearer {{adminJwt}}
Content-Type: application/json

{
  "name": "Client Website",
  "dailyLimit": 100,
  "allowedIps": []
}

### Send OTP
POST {{baseUrl}}/api/otp/send
Authorization: Bearer {{clientApiKey}}
Content-Type: application/json

{
  "mobile": "+919876543210",
  "template": "Your OTP is {otp}",
  "length": 6
}

### Send any general message
POST {{baseUrl}}/api/messages/send
Authorization: Bearer {{clientApiKey}}
Content-Type: application/json

{
  "mobile": "+919876543210",
  "message": "Happy birthday! Wishing you a wonderful year ahead."
}

### Android reports SMS status
POST {{baseUrl}}/api/device/sms-status
Authorization: Bearer {{deviceToken}}
Content-Type: application/json

{
  "request_id": "{{requestId}}",
  "status": "sent",
  "error": null,
  "timestamp": "REPLACE_WITH_13_DIGIT_MILLISECONDS"
}

### Verify OTP
POST {{baseUrl}}/api/otp/verify
Authorization: Bearer {{clientApiKey}}
Content-Type: application/json

{
  "request_id": "{{requestId}}",
  "code": "123456"
}

### Get OTP status
GET {{baseUrl}}/api/otp/status/{{requestId}}
Authorization: Bearer {{clientApiKey}}

### Get general message status
GET {{baseUrl}}/api/messages/status/{{requestId}}
Authorization: Bearer {{clientApiKey}}
